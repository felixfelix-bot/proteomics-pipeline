# Data files - NEVER commit actual data
# Ignore ALL data subdirectories (mass spec output folders)
data/*/
# Ignore data files in data/ root
data/*.csv
data/*.txt
data/*.tsv
data/*.xlsx
data/*.fasta
# Explicitly keep known interactors list (no sensitive data)
!data/known_interactors.txt
!data/README.md

# R environment
.Rhistory
.RData
.Rproj.user/
*.Rproj
Rplots.pdf

# Output
output/
figures/

# Poster build artifacts (generated, not committed)
poster/figures/*
!poster/figures/.gitkeep
poster/*.aux
poster/*.log
poster/*.out
poster/*.fdb_latexmk
poster/*.fls
poster/*.synctex.gz

# Ansible
*.retry
ansible/vault_pass*

# OS
.DS_Store
Thumbs.db
__pycache__/
